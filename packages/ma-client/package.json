{
    "name": "music-assistant-client",
    "version": "0.1.0",
    "description": "Typed TypeScript client for the Music Assistant WebSocket API: token auth, live player and queue state, auto-reconnect, convenience commands, and every API command typed.",
    "license": "MIT",
    "author": "Boris Kemper",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rocklobster42195/streamdeck-music-assistant-controller.git",
        "directory": "packages/ma-client"
    },
    "homepage": "https://github.com/rocklobster42195/streamdeck-music-assistant-controller/tree/main/packages/ma-client#readme",
    "bugs": {
        "url": "https://github.com/rocklobster42195/streamdeck-music-assistant-controller/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "keywords": [
        "music-assistant",
        "music assistant",
        "home-assistant",
        "home assistant",
        "websocket",
        "client",
        "typescript",
        "sonos",
        "airplay",
        "chromecast"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint src test"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    }
}
