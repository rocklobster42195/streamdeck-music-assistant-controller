{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Music Assistant Controller",
	"Version": "0.1.0.0",
	"Author": "Boris Kemper",
	"Actions": [
		{
			"Name": "Play/Pause",
			"UUID": "de.boriskemper.music-assistant-controller.play-pause-key",
			"Icon": "imgs/actions/play-pause-key/icon",
			"Tooltip": "Toggle play/pause with cover art.",
			"PropertyInspectorPath": "ui/play-pause-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-pause-key/key"
				}
			]
		},
		{
			"Name": "Play Item",
			"UUID": "de.boriskemper.music-assistant-controller.play-item-key",
			"Icon": "imgs/actions/play-item-key/icon",
			"Tooltip": "Play a playlist, album, radio station or podcast from your library.",
			"PropertyInspectorPath": "ui/play-item-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-item-key/key"
				}
			]
		},
		{
			"Name": "Playback Control",
			"UUID": "de.boriskemper.music-assistant-controller.playback-control-key",
			"Icon": "imgs/actions/playback-control-key/icon",
			"Tooltip": "Next, previous, shuffle, repeat, crossfade or “Don't stop the music”.",
			"PropertyInspectorPath": "ui/playback-control-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/playback-control-key/key"
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "de.boriskemper.music-assistant-controller.volume-key",
			"Icon": "imgs/actions/volume-key/icon",
			"Tooltip": "Volume up, down, mute or a preset.",
			"PropertyInspectorPath": "ui/volume-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/volume-key/key"
				}
			]
		},
		{
			"Name": "Like",
			"UUID": "de.boriskemper.music-assistant-controller.like-key",
			"Icon": "imgs/actions/like-key/icon",
			"Tooltip": "Add the current track to your favorites, or remove it.",
			"PropertyInspectorPath": "ui/like-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/like-key/key"
				}
			]
		},
		{
			"Name": "Track",
			"UUID": "de.boriskemper.music-assistant-controller.track-dial",
			"Icon": "imgs/actions/track-dial/icon",
			"Tooltip": "Cover, title and progress on the display. Rotate to seek.",
			"PropertyInspectorPath": "ui/track-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Seek",
					"Push": "Next track",
					"Touch": "Play / pause"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/track-dial/key"
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "de.boriskemper.music-assistant-controller.volume-dial",
			"Icon": "imgs/actions/volume-dial/icon",
			"Tooltip": "Volume on a dial, with mute and a preset.",
			"PropertyInspectorPath": "ui/volume-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Volume",
					"Push": "Mute",
					"Touch": "Preset (hold: save)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/volume-dial/key"
				}
			]
		},
		{
			"Name": "Browser",
			"UUID": "de.boriskemper.music-assistant-controller.browser-dial",
			"Icon": "imgs/actions/browser-dial/icon",
			"Tooltip": "Browse all providers or your library with the dial and play what you find.",
			"PropertyInspectorPath": "ui/browser-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Scroll",
					"Push": "Open / play",
					"Touch": "Back (hold: start)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/browser-dial/key"
				}
			]
		},
		{
			"Name": "Player",
			"UUID": "de.boriskemper.music-assistant-controller.player-key",
			"Icon": "imgs/actions/player-key/icon",
			"Tooltip": "Make this room the active player — and bring the music along.",
			"PropertyInspectorPath": "ui/player-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/player-key/key"
				}
			]
		},
		{
			"Name": "Active Player",
			"UUID": "de.boriskemper.music-assistant-controller.player-dial",
			"Icon": "imgs/actions/player-dial/icon",
			"Tooltip": "Choose the active player with the dial and bring the music there.",
			"PropertyInspectorPath": "ui/player-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Choose player",
					"Push": "Bring music here",
					"Touch": "Play / pause"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/player-dial/key"
				}
			]
		},
		{
			"Name": "Queue",
			"UUID": "de.boriskemper.music-assistant-controller.queue-dial",
			"Icon": "imgs/actions/queue-dial/icon",
			"Tooltip": "Scroll through the queue and jump to any track.",
			"PropertyInspectorPath": "ui/queue-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Scroll queue",
					"Push": "Play track",
					"Touch": "Back to current"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/queue-dial/key"
				}
			]
		},
		{
			"Name": "Group Volume",
			"UUID": "de.boriskemper.music-assistant-controller.group-volume-dial",
			"Icon": "imgs/actions/group-volume-dial/icon",
			"Tooltip": "Volume of the whole speaker group.",
			"PropertyInspectorPath": "ui/group-volume-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Group volume",
					"Push": "Mute group",
					"Touch": "Preset (hold: save)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/group-volume-dial/key"
				}
			]
		},
		{
			"Name": "Panorama",
			"UUID": "de.boriskemper.music-assistant-controller.panorama-dial",
			"Icon": "imgs/actions/panorama-dial/icon",
			"Tooltip": "Ambient effects spanning neighbouring dials, tinted by the cover.",
			"PropertyInspectorPath": "ui/panorama-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Adjust effect",
					"Push": "Effect action",
					"Touch": "Interact"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/panorama-dial/key"
				}
			]
		},
		{
			"Name": "Sleep Timer",
			"UUID": "de.boriskemper.music-assistant-controller.sleep-timer-key",
			"Icon": "imgs/actions/sleep-timer-key/icon",
			"Tooltip": "Stop the music after 15, 30, 60 or 90 minutes.",
			"PropertyInspectorPath": "ui/sleep-timer-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/sleep-timer-key/key"
				}
			]
		},
		{
			"Name": "Announcement",
			"UUID": "de.boriskemper.music-assistant-controller.announce-key",
			"Icon": "imgs/actions/announce-key/icon",
			"Tooltip": "Speak a message on one or all speakers.",
			"PropertyInspectorPath": "ui/announce-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/announce-key/key"
				}
			]
		},
		{
			"Name": "Source",
			"UUID": "de.boriskemper.music-assistant-controller.source-key",
			"Icon": "imgs/actions/source-key/icon",
			"Tooltip": "Switch a speaker to an input like Line-in or TV.",
			"PropertyInspectorPath": "ui/source-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/source-key/key"
				}
			]
		},
		{
			"Name": "Cast Dashboard",
			"UUID": "de.boriskemper.music-assistant-controller.dashboard-key",
			"Icon": "imgs/actions/dashboard-key/icon",
			"Tooltip": "Show a Music Assistant dashboard on a TV or screen.",
			"PropertyInspectorPath": "ui/dashboard-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/dashboard-key/key"
				}
			]
		}
	],
	"Category": "Music Assistant Controller",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control Music Assistant from your Stream Deck: every speaker, every streaming service, one deck.\nUnofficial community plugin, not affiliated with Music Assistant or Elgato.\n\nIcons by https://pictogrammers.com",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "de.boriskemper.music-assistant-controller"
}
