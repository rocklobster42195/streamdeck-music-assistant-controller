{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Music Assistant Controller",
	"Version": "0.1.0.0",
	"Author": "Boris Kemper",
	"Actions": [
		{
			"Name": "Play/Pause",
			"UUID": "de.boriskemper.music-assistant-controller.play-pause-key",
			"Icon": "imgs/actions/play-pause-key/icon",
			"Tooltip": "Toggle play/pause with cover art.",
			"PropertyInspectorPath": "ui/play-pause-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-pause-key/key"
				}
			]
		},
		{
			"Name": "Play Item",
			"UUID": "de.boriskemper.music-assistant-controller.play-item-key",
			"Icon": "imgs/actions/play-item-key/icon",
			"Tooltip": "Play a playlist, album, radio station or podcast from your library.",
			"PropertyInspectorPath": "ui/play-item-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/play-item-key/key"
				}
			]
		},
		{
			"Name": "Playback Control",
			"UUID": "de.boriskemper.music-assistant-controller.playback-control-key",
			"Icon": "imgs/actions/playback-control-key/icon",
			"Tooltip": "Next, previous, shuffle, repeat, crossfade or “Don't stop the music”.",
			"PropertyInspectorPath": "ui/playback-control-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/playback-control-key/key"
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "de.boriskemper.music-assistant-controller.volume-key",
			"Icon": "imgs/actions/volume-key/icon",
			"Tooltip": "Volume up, down, mute or a preset.",
			"PropertyInspectorPath": "ui/volume-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/volume-key/key"
				}
			]
		},
		{
			"Name": "Like",
			"UUID": "de.boriskemper.music-assistant-controller.like-key",
			"Icon": "imgs/actions/like-key/icon",
			"Tooltip": "Add the current track to your favorites, or remove it.",
			"PropertyInspectorPath": "ui/like-key.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/like-key/key"
				}
			]
		},
		{
			"Name": "Track",
			"UUID": "de.boriskemper.music-assistant-controller.track-dial",
			"Icon": "imgs/actions/track-dial/icon",
			"Tooltip": "Cover, title and progress on the display. Rotate to seek.",
			"PropertyInspectorPath": "ui/track-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Seek",
					"Push": "Next track",
					"Touch": "Play / pause"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/track-dial/key"
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "de.boriskemper.music-assistant-controller.volume-dial",
			"Icon": "imgs/actions/volume-dial/icon",
			"Tooltip": "Volume on a dial, with mute and a preset.",
			"PropertyInspectorPath": "ui/volume-dial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Volume",
					"Push": "Mute",
					"Touch": "Preset (hold: save)"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/volume-dial/key"
				}
			]
		}
	],
	"Category": "Music Assistant Controller",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control Music Assistant from your Stream Deck: every speaker, every streaming service, one deck.\nUnofficial community plugin, not affiliated with Music Assistant or Elgato.\n\nIcons by https://pictogrammers.com",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "de.boriskemper.music-assistant-controller"
}
