{
    "name": "mac-plugin",
    "version": "0.1.0-beta.4",
    "private": true,
    "description": "MAC — Music Assistant Controller: the Stream Deck plugin",
    "license": "MIT",
    "author": "Boris Kemper",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart de.boriskemper.music-assistant-controller\"",
        "link": "streamdeck link de.boriskemper.music-assistant-controller.sdPlugin",
        "validate": "streamdeck validate de.boriskemper.music-assistant-controller.sdPlugin",
        "pack": "streamdeck pack de.boriskemper.music-assistant-controller.sdPlugin --force"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.0",
        "@mdi/js": "^7.4.47",
        "@rocklobster42195/streamdeck-kit": "0.1.0-alpha.43",
        "music-assistant-client": "^0.1.0"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/ws": "^8.18.1",
        "rollup": "^4.62.2",
        "sharp": "^0.35.4",
        "tslib": "^2.6.2",
        "ws": "^8.21.3"
    }
}
