{
    "name": "mac",
    "private": true,
    "description": "MAC — Music Assistant Controller for Elgato Stream Deck (monorepo)",
    "license": "MIT",
    "author": "Boris Kemper",
    "type": "module",
    "workspaces": [
        "plugin"
    ],
    "scripts": {
        "build": "npm run build -w mac-plugin && node tools/build-translator.mjs",
        "watch": "npm run watch -w mac-plugin",
        "test": "vitest run",
        "lint": "eslint plugin/src",
        "probe": "node tools/ma-probe.mjs",
        "pi:preview": "node tools/pi-preview.mjs",
        "sim:play-pause": "node tools/sd-sim/play-pause.mjs sim-out",
        "sim:keys": "node tools/sd-sim/keys.mjs sim-out",
        "pi:live": "node tools/sd-sim/pi-live.mjs",
        "sim:play-item": "node tools/sd-sim/play-item.mjs sim-out",
        "sim:dials": "node tools/sd-sim/dials.mjs sim-out",
        "sim:all": "npm run sim:play-pause && npm run sim:keys && npm run sim:play-item && npm run sim:dials && npm run sim:browser && npm run sim:players && npm run sim:queue-group && npm run sim:extras && npm run sim:continue",
        "sim:browser": "node tools/sd-sim/browser.mjs sim-out",
        "sim:players": "node tools/sd-sim/players.mjs sim-out",
        "sim:queue-group": "node tools/sd-sim/queue-group.mjs sim-out",
        "sim:extras": "node tools/sd-sim/extras.mjs sim-out",
        "sim:lyrics": "node tools/sd-sim/lyrics.mjs sim-out",
        "sim:continue": "node tools/sd-sim/continue.mjs sim-out",
        "sim:list": "node tools/sd-sim/list.mjs sim-out",
        "sim:announce-timer": "node tools/sd-sim/announce-timer.mjs sim-out",
        "showcase": "node tools/sd-sim/showcase.mjs sim-out",
        "pi-shots": "node tools/pi-shots.mjs",
        "store-assets": "node tools/generate-store-assets.mjs",
        "sim:deckbus": "node tools/sd-sim/deckbus.mjs sim-out",
        "sim:effect-sync": "node tools/sd-sim/effect-sync.mjs sim-out",
        "translate": "node tools/serve-translate.mjs",
        "translate:build": "node tools/build-translator.mjs",
        "check": "npm run build && npm test && npm run lint && npm run validate -w mac-plugin",
        "version:patch": "node tools/bump-version.mjs patch",
        "version:minor": "node tools/bump-version.mjs minor",
        "version:major": "node tools/bump-version.mjs major",
        "version:beta": "node tools/bump-version.mjs beta",
        "release": "node tools/release.mjs",
        "ship:patch": "npm run check && npm run version:patch && npm run release",
        "ship:minor": "npm run check && npm run version:minor && npm run release",
        "ship:major": "npm run check && npm run version:major && npm run release",
        "ship:beta": "npm run check && npm run version:beta && npm run release"
    },
    "devDependencies": {
        "@types/node": "~24.3.0",
        "eslint": "^10.6.0",
        "puppeteer-core": "^25.12.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.10",
        "@tsconfig/node24": "^24.0.5"
    }
}
