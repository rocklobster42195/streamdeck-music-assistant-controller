{
    "name": "mac",
    "private": true,
    "description": "MAC — Music Assistant Controller for Elgato Stream Deck (monorepo)",
    "license": "MIT",
    "author": "Boris Kemper",
    "type": "module",
    "workspaces": [
        "packages/ma-client",
        "packages/streamdeck-core",
        "plugin"
    ],
    "scripts": {
        "build": "npm run build -w music-assistant-client -w streamdeck-core && npm run build -w mac-plugin",
        "watch": "npm run build -w music-assistant-client -w streamdeck-core && npm run watch -w mac-plugin",
        "test": "vitest run",
        "lint": "eslint packages plugin/src",
        "probe": "node tools/ma-probe.mjs",
        "pi:preview": "node tools/pi-preview.mjs",
        "sim:play-pause": "node tools/sd-sim/play-pause.mjs sim-out",
        "sim:keys": "node tools/sd-sim/keys.mjs sim-out",
        "pi:live": "node tools/sd-sim/pi-live.mjs",
        "sim:play-item": "node tools/sd-sim/play-item.mjs sim-out",
        "sim:dials": "node tools/sd-sim/dials.mjs sim-out",
        "sim:all": "npm run sim:play-pause && npm run sim:keys && npm run sim:play-item && npm run sim:dials && npm run sim:browser && npm run sim:players",
        "sim:browser": "node tools/sd-sim/browser.mjs sim-out",
        "sim:players": "node tools/sd-sim/players.mjs sim-out"
    },
    "devDependencies": {
        "@tsconfig/node20": "^20.1.9",
        "@types/node": "~20.15.0",
        "eslint": "^10.6.0",
        "puppeteer-core": "^25.12.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.10"
    }
}
